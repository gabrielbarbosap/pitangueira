# ============================================================
# Pitangueira — copie este arquivo para .env.local e preencha.
# Enquanto estiver vazio, o app roda em MODO DEMO (dados de exemplo no navegador, sem login real).
#
# Onde pegar: console.firebase.google.com -> seu projeto ->
# Configurações do projeto (engrenagem) -> Seus apps -> App da Web -> Configuração do SDK.
#
# Na Vercel, cadastre estas mesmas 6 variáveis em Settings -> Environment Variables.
# ============================================================

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------
# Análise e divulgação (OPCIONAL). Sem estes IDs, nada de terceiros carrega.
# Só carregam quando a pessoa ACEITA o aviso de cookies (LGPD).
#  - GA4: analytics.google.com -> Admin -> Fluxos de dados -> ID da métrica (começa com G-)
#  - Pixel: business.facebook.com -> Gerenciador de eventos -> ID do pixel (número)
# Cadastre também na Vercel (Settings -> Environment Variables).
# ------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
